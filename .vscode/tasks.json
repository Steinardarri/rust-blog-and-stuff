{
  "version": "2.0.0",
  "presentation": {
    "echo": false,
    "reveal": "always",
    "focus": false,
    "panel": "dedicated",
    "showReuseMessage": true
  },
  "tasks": [
    {
      "label": "Serve Website",
      "dependsOn": ["Trunk", "Clippy", "Format"],
      // Mark as the default build task so ctrl+shift+b will create them
      "group": {
        "kind": "build",
        "isDefault": true
      },
      // // Try start the task on folder open
      // "runOptions": {
      //   "runOn": "folderOpen"
      // },
      "icon": {
        "id": "browser",
        "color": "terminal.ansiMagenta"
      }
    },
    {
      // The name that shows up in terminal tab
      "label": "Trunk",
      // The task will launch a shell
      "type": "shell",
      "command": "trunk serve",
      // Set the shell type,
      // Mark as a background task to avoid the spinner animation on the terminal tab
      "isBackground": true,
      "problemMatcher": [],
      // Create the tasks in a terminal group
      "presentation": {
        "group": "trunk-group"
      },
      "icon": {
        "id": "server-process",
        "color": "terminal.ansiGreen"
      }
    },
    {
      "label": "Clippy",
      "type": "shell",
      "command": "cargo clippy --all-features -- -D warnings -W clippy::pedantic",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "trunk-group"
      },
      "icon": {
        "id": "clippy",
        "color": "terminal.ansiYellow"
      }
    },
    {
      "label": "Format",
      "type": "shell",
      "command": "cargo fmt --all -- --check",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "trunk-group"
      },
      "icon": {
        "id": "search",
        "color": "terminal.ansiBlue"
      }
    }
  ]
}
